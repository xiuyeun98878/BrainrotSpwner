bar.BackgroundColor3 = Color3.fromRGB(175, 75, 255)
bar.BorderSizePixel = 0
bar.Parent = barBG

Instance.new("UICorner", bar).CornerRadius =
    UDim.new(1, 0)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 25)
status.Position = UDim2.new(0, 0, 0.59, 0)
status.BackgroundTransparency = 1
status.Text = "LOADING ASSETS..."
status.TextColor3 = Color3.fromRGB(175, 100, 255)
status.TextSize = 12
status.Font = Enum.Font.GothamBold
status.Parent = main

-- Smooth loading animation
local tween = TweenService:Create(
    bar,
    TweenInfo.new(20, Enum.EasingStyle.Linear),
    {Size = UDim2.new(1, 0, 1, 0)}
)

tween:Play()

task.wait(20)

status.Text = "LOADING COMPLETE!"

task.wait(0.5)

local fade = TweenService:Create(
    main,
    TweenInfo.new(0.5),
    {BackgroundTransparency = 1}
)

fade:Play()

for _, object in pairs(main:GetDescendants()) do
    if object:IsA("TextLabel") then
        TweenService:Create(
            object,
            TweenInfo.new(0.5),
            {TextTransparency = 1}
        ):Play()
    elseif object:IsA("Frame") then
        TweenService:Create(
            object,
            TweenInfo.new(0.5),
            {BackgroundTransparency = 1}
        ):Play()
    end
end

task.wait(0.6)
gui:Destroy()
